# Railway Postgres (default - no config needed for local dev)
# VITE_API_BASE_URL=http://localhost:3001
# Set VITE_USE_RAILWAY=false to use Supabase instead

# Supabase Configuration (legacy - when VITE_USE_RAILWAY=false)
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_KEY=your_supabase_anon_key_here

# Mapbox Configuration
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# AWS S3 Configuration
VITE_AWS_REGION=us-east-1
VITE_AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
VITE_AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
VITE_S3_BUCKET_NAME=biochar-photos

# Note: For production, use environment variables or secure configuration
# For development, you can set these in a .env.local file
