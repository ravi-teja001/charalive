{
  "name": "biochar-bloom",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@10.2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:frontend\"",
    "dev:server": "cd server && npm run dev",
    "dev:frontend": "vite",
    "build": "tsc && vite build",
    "build:apk": "vite build --mode production && npx cap sync android && cd android && ./gradlew assembleRelease && cd .. && cp android/app/build/outputs/apk/release/app-release.apk APK_DISTRIBUTION/Biochar-Management-System-LATEST.apk",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "setup-db": "node scripts/apply-all-migrations.js",
    "deploy:railway": "cd server && railway up",
    "deploy:all": "bash scripts/deploy-all.sh"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.1",
